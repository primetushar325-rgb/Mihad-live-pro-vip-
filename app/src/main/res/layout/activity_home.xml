<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        style="@style/TextAppearance.LiveHead.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />

                    <TextView
                        style="@style/TextAppearance.LiveHead.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tagline" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_diagnostics"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_diagnostics"
                    android:contentDescription="@string/diagnostics" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings" />
            </LinearLayout>

            <!-- Status pill -->
            <TextView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_gray"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_surface_muted"
                android:text="@string/status_offline" />

            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <!-- ============ SETUP PANE ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Video card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.LiveHead.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_video" />

                        <Button
                            android:id="@+id/btn_select_video"
                            style="@style/Widget.LiveHead.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/select_video" />

                        <TextureView
                            android:id="@+id/preview"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_video_frame"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/preview_controls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">

                            <Button
                                android:id="@+id/btn_preview_toggle"
                                style="@style/Widget.LiveHead.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/preview" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/video_name"
                            style="@style/TextAppearance.LiveHead.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/no_video_selected"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/video_details"
                            style="@style/TextAppearance.LiveHead.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- YouTube card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.LiveHead.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_youtube" />

                        <TextView
                            style="@style/TextAppearance.LiveHead.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/stream_url" />

                        <EditText
                            android:id="@+id/input_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:padding="12dp"
                            android:inputType="textUri"
                            android:hint="@string/stream_url_hint"
                            android:textColorHint="@color/on_surface_faint"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface" />

                        <TextView
                            style="@style/TextAppearance.LiveHead.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/stream_key" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/input_key"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_input"
                                android:paddingStart="12dp"
                                android:paddingEnd="64dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:inputType="textPassword"
                                android:typeface="monospace"
                                android:hint="@string/stream_key_hint"
                                android:textColorHint="@color/on_surface_faint"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface" />

                            <ImageButton
                                android:id="@+id/btn_key_visibility"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="end|center_vertical"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_eye"
                                android:contentDescription="@string/show" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Switch
                                android:id="@+id/switch_remember_key"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/remember_key"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_muted" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Settings card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.LiveHead.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_settings" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.LiveHead.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/resolution" />

                                <Spinner
                                    android:id="@+id/spinner_resolution"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_input"
                                    android:padding="4dp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.LiveHead.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fps" />

                                <Spinner
                                    android:id="@+id/spinner_fps"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_input"
                                    android:padding="4dp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.LiveHead.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/bitrate" />

                        <Spinner
                            android:id="@+id/spinner_bitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input"
                            android:padding="4dp"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                style="@style/TextAppearance.LiveHead.Label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/loop_video" />

                            <Switch
                                android:id="@+id/switch_loop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Battery card -->
                    <LinearLayout
                        android:id="@+id/card_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_battery" />

                            <TextView
                                style="@style/TextAppearance.LiveHead.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/battery_hint_title"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.LiveHead.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/battery_hint_body" />

                        <Button
                            android:id="@+id/btn_battery_opt"
                            style="@style/Widget.LiveHead.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/battery_hint_title" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_start"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/start_live"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFFFF" />
                </LinearLayout>

                <!-- ============ LIVE PANE ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/banner_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner_error"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/live_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/banner_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner_warn"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/warn_yellow"
                        android:text="@string/upload_health_warning"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/banner_thermal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_banner_warn"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/warn_yellow"
                        android:text="@string/thermal_warning"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/banner_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_banner_warn"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/warn_yellow"
                        android:text="@string/battery_low_warning"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/live_video_name"
                            style="@style/TextAppearance.LiveHead.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium" />

                        <GridLayout
                            android:id="@+id/live_stats_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:useDefaultMargins="true" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/stop_live"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFFFF" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
